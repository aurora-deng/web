{
  "node": {"id": "nebula-ingress-lab", "cluster": "nebula-ingress"},
  "admin": {"allow_paths": [{"exact": "/ready"}, {"exact": "/stats/prometheus"}]},
  "static_resources": {
    "listeners": [{
      "name": "nebula_http",
      "per_connection_buffer_limit_bytes": 32768,
      "filter_chains": [{"filters": [{
        "name": "envoy.filters.network.http_connection_manager",
        "typed_config": {
          "@type": "type.googleapis.com/envoy.extensions.filters.network.http_connection_manager.v3.HttpConnectionManager",
          "stat_prefix": "nebula_gateway",
          "codec_type": "AUTO",
          "normalize_path": true,
          "merge_slashes": true,
          "path_with_escaped_slashes_action": "REJECT_REQUEST",
          "use_remote_address": true,
          "skip_xff_append": true,
          "generate_request_id": true,
          "preserve_external_request_id": false,
          "always_set_request_id_in_response": true,
          "request_headers_timeout": "15s",
          "stream_idle_timeout": "90s",
          "upgrade_configs": [{"upgrade_type": "websocket"}],
          "route_config": {
            "name": "nebula_ingress",
            "virtual_hosts": [{"name": "nebula", "domains": ["127.0.0.1", "localhost", "127.0.0.1:*", "localhost:*"]}]
          },
          "access_log": [{
            "name": "envoy.access_loggers.file",
            "filter": {"header_filter": {"header": {"name": ":path", "string_match": {"exact": "/fast"}, "invert_match": true}}},
            "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.access_loggers.file.v3.FileAccessLog",
              "log_format": {"json_format": {
                "at": "%EMIT_TIME(%s.%3f)%",
                "requestId": "%REQUEST_HEADER(X-REQUEST-ID)%",
                "route": "%ROUTE_NAME%",
                "status": "%RESPONSE_CODE%",
                "durationUs": "%COMMON_DURATION(DS_RX_BEG:DS_TX_END:us)%",
                "elapsedMs": "%DURATION%",
                "upstreamConnectUs": "%COMMON_DURATION(US_CX_BEG:US_CX_END:us)%",
                "upstreamHeaderUs": "%COMMON_DURATION(US_TX_BEG:US_RX_BEG:us)%",
                "upstreamResponseUs": "%COMMON_DURATION(US_TX_BEG:US_RX_END:us)%",
                "details": "%RESPONSE_CODE_DETAILS%",
                "traceId": "%RESPONSE_HEADER(X-NEBULA-TRACE-ID)%"
              }}
            }
          }],
          "http_filters": [
            {"name": "envoy.filters.http.header_mutation", "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.filters.http.header_mutation.v3.HeaderMutation",
              "mutations": {"request_mutations": [
                {"remove": "forwarded"}, {"remove": "x-forwarded-for"}, {"remove": "x-real-ip"},
                {"remove": "x-forwarded-client-cert"}, {"remove": "x-envoy-original-path"},
                {"remove": "x-envoy-retry-on"}, {"remove": "x-envoy-retry-grpc-on"}, {"remove": "x-envoy-max-retries"},
                {"remove": "x-envoy-upstream-rq-timeout-ms"}, {"remove": "x-envoy-upstream-rq-per-try-timeout-ms"},
                {"remove": "x-envoy-upstream-rq-timeout-alt-response"}, {"remove": "x-envoy-hedge-on-per-try-timeout"}
              ]}
            }},
            {"name": "envoy.filters.http.local_ratelimit", "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.filters.http.local_ratelimit.v3.LocalRateLimit",
              "stat_prefix": "nebula_gateway"
            }},
            {"name": "envoy.filters.http.router", "typed_config": {
              "@type": "type.googleapis.com/envoy.extensions.filters.http.router.v3.Router"
            }}
          ]
        }
      }]}]
    }],
    "clusters": [{
      "name": "nebula_application",
      "type": "STATIC",
      "connect_timeout": "2s",
      "per_connection_buffer_limit_bytes": 32768,
      "circuit_breakers": {"thresholds": [{"priority": "DEFAULT", "max_connections": 128,
        "max_pending_requests": 64, "max_requests": 192, "max_retries": 0}]}
    }]
  }
}
