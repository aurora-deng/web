  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "phase11_session"
      }
    },
    "schemas": {
      "DecimalId": {
        "type": "string",
        "pattern": "^[0-9]+$"
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      },
      "UserCard": {
        "type": "object",
        "required": [
          "id",
          "username",
          "displayName",
          "friendship",
          "pendingRequest",
          "canRequestFriendship"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DecimalId"
          },
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "friendship": {
            "type": "boolean"
          },
          "pendingRequest": {
            "type": "boolean"
          },
          "canRequestFriendship": {
            "type": "boolean"
          },
          "aiAccount": {
            "type": "boolean"
          }
        }
      },
      "Preference": {
        "type": "object",
        "required": [
          "conversationId",
          "notificationsMuted",
          "version"
        ],
        "properties": {
          "conversationId": {
            "$ref": "#/components/schemas/DecimalId"
          },
          "notificationsMuted": {
            "type": "boolean"
          },
          "version": {
            "$ref": "#/components/schemas/DecimalId"
          }
        }
      },
      "LegacyMessage": {
        "type": "object",
        "description": "Existing wire DTO is retained. Numeric legacy IDs/sequences remain; new cursors are decimal strings. Do not infer a whole-project 64-bit migration.",
        "required": [
          "id",
          "conversationId",
          "sequence",
          "senderId",
          "body",
          "state",
          "attachments"
        ],
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "active",
              "recalled"
            ]
          },
          "body": {
            "type": "string"
          },
          "attachments": {
            "type": "array"
          }
        }
      }
    }
  }
}
