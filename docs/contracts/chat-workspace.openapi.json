        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "notificationsMuted"
                ],
                "properties": {
                  "notificationsMuted": {
                    "oneOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "string",
                        "enum": [
                          "true",
                          "false"
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/conversations/{id}/messages/{messageId}/context": {
      "get": {
        "summary": "Re-authorized bounded context, recalled body/media redacted",
        "security": [
          {
            "sessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "target",
                    "items"
                  ],
                  "properties": {
                    "target": {
                      "$ref": "#/components/schemas/LegacyMessage"
                    },
                    "items": {
                      "type": "array",
                      "maxItems": 101,
                      "items": {
                        "$ref": "#/components/schemas/LegacyMessage"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
